<odoo>
    <record id="view_pe_ai_conversation_tree" model="ir.ui.view">
        <field name="name">pe.ai.conversation.tree</field>
        <field name="model">pe.ai.conversation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="channel"/>
                <field name="external_chat_id"/>
                <field name="active"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="view_pe_ai_conversation_form" model="ir.ui.view">
        <field name="name">pe.ai.conversation.form</field>
        <field name="model">pe.ai.conversation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="channel"/>
                        <field name="external_chat_id"/>
                        <field name="active"/>
                    </group>
                    <field name="message_ids">
                        <list>
                            <field name="create_date"/>
                            <field name="role"/>
                            <field name="body"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pe_ai_conversation" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">pe.ai.conversation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
