<odoo>
    <record id="view_pe_ai_knowledge_tree" model="ir.ui.view">
        <field name="name">pe.ai.knowledge.tree</field>
        <field name="model">pe.ai.knowledge</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category"/>
                <field name="status"/>
                <field name="visibility"/>
                <field name="source"/>
                <field name="version"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="view_pe_ai_knowledge_form" model="ir.ui.view">
        <field name="name">pe.ai.knowledge.form</field>
        <field name="model">pe.ai.knowledge</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate" invisible="status == 'active'"/>
                    <button name="action_archive" type="object" string="Archive" invisible="status == 'archived'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="visibility"/>
                        <field name="source"/>
                        <field name="source_ref"/>
                        <field name="version"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Knowledge">
                            <field name="content" placeholder="Nội dung kiến thức..."/>
                        </page>
                        <page string="Chatter">
                            <field name="message_follower_ids" widget="mail_followers"/>
                            <field name="activity_ids" widget="mail_activity"/>
                            <field name="message_ids" widget="mail_thread"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pe_ai_knowledge" model="ir.actions.act_window">
        <field name="name">Knowledge</field>
        <field name="res_model">pe.ai.knowledge</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
